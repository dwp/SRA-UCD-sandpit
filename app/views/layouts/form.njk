{% extends "layouts/main.html" %}


{% block beforeContent %}
{{ 
    govukBackLink({
        text: "Back",
        href: "javascript: history.back();"
    })
}}
{% endblock %}


{% block content %}

<form method="post" action="{{ formAction | d("#") }}">

    {% block pageContent %}

    {% endblock %}

    {% block pageButton %}
    {{ 
        govukButton({
            text: formButton | d("Save and continue")
        }) 
    }}
    {% endblock %}

</form>


{% endblock %}