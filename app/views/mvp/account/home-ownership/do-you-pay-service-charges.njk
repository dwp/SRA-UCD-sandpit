{% extends "layouts/form.html" %}

{% set pageName="Do you pay a service charge or ground rent at your new address?" %}

{% block pageContent %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {{ 
        govukRadios({
            name: "doYoupayAServiceChange",
            fieldset: {
                legend: {
                    text: pageName,
                    isPageHeading: true,
                    classes: "govuk-fieldset__legend--l"
                }
            },
            items: [
                {
                    value: "Yes",
                    text: "Yes",
                    checked: true if data.doYoupayAServiceChange === "Yes"
                },
                {
                    value: "No",
                    text: "No",
                    checked: true if data.doYoupayAServiceChange === "No"
                },
                {
                    value: "Do not know",
                    text: "Do not know",
                    checked: true if data.doYoupayAServiceChange === "Do not know"
                }
            ]
        })
    }}

  </div>
</div>

{% endblock %}
